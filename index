<script>
/* =========================================================
   ★ 新人資料設定區：換一組新人時，只需要改這裡 ★
   ========================================================= */
var CONFIG = {
  groom: '新郎',               // ← 請填新郎姓名
  bride: 'Vivian',
  groomEn: 'Groom',            // 照片下方與英文副標用，可留空
  brideEn: 'Vivian',
  date: '2027-02-14',          // 婚禮日期，格式 YYYY-MM-DD（檢核表截止日會自動依此回推）
  venue: '婚宴場地',           // ← 請填場地名稱
  appsScriptUrl: 'PASTE_YOUR_APPS_SCRIPT_URL_HERE',   // 貼上 Apps Script 部署後 /exec 結尾的網址
  photoUrl: '',                // 婚紗照網址或 base64，留空則顯示預留框
  paymentsPasscode: '0000'     // 尾款頁通關密碼（僅為輕量保護）
};

/* 試算表「Itinerary」分頁是空的時候，可以一鍵帶入的預設流程草案 */
var DEFAULT_ITINERARY = [
  {outline:'賓客入場・自由接待', summary:'賓客簽到、領取座位卡，自由拍照與交流', music:'輕柔背景音樂', screen:'新人照片輪播', props:'簽名簿、座位卡', note:'若決定新人在接待處迎賓，新人此時已在接待處'},
  {outline:'主持人開場＋新人進場', summary:'主持人開場致詞，接著新人進場', music:'進場音樂', screen:'', props:'', note:'待定：A. 新人在接待處迎賓，主持人開場後請新人上台；B. 主持人開場後 cue 新人正式進場（需確認場地動線）'},
  {outline:'交換戒指儀式', summary:'新人交換戒指', music:'儀式音樂', screen:'', props:'戒指、戒枕', note:'考慮中，待新人確認'},
  {outline:'小遊戲時間', summary:'主持人帶領賓客互動小遊戲', music:'', screen:'遊戲畫面', props:'遊戲道具、小禮物', note:'考慮中，遊戲內容與獎品待定'},
  {outline:'逐桌敬酒・聊天', summary:'新人逐桌敬酒，與賓客聊天合照', music:'背景音樂', screen:'新人照片輪播', props:'', note:''},
  {outline:'甜點時刻・收尾致詞', summary:'甜點上桌，主持人收尾，新人簡單致詞感謝賓客蒞臨', music:'', screen:'', props:'麥克風', note:''},
  {outline:'送客', summary:'新人於門口送客', music:'送客音樂', screen:'', props:'送客小物', note:''}
];

(function(){
  function pad(n){ return String(n).padStart(2,'0'); }
  function ymd(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); }
  function slashDate(s){ return s.replace(/-/g,'/'); }
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

  var WEDDING_DATE = new Date(CONFIG.date + 'T00:00:00');
  var namesLine = CONFIG.groom + ' & ' + CONFIG.bride;

  // ---------- 套用新人資料 ----------
  document.title = slashDate(CONFIG.date) + ' ' + namesLine + '・婚禮籌備手帖';
  document.getElementById('hGroom').textContent = CONFIG.groom;
  document.getElementById('hBride').textContent = CONFIG.bride;
  document.getElementById('hEnNames').textContent = (CONFIG.groomEn && CONFIG.brideEn) ? (CONFIG.groomEn + ' & ' + CONFIG.brideEn) : '';
  document.getElementById('hDate').textContent = slashDate(CONFIG.date);
  document.getElementById('hVenue').textContent = CONFIG.venue;
  document.getElementById('postmarkYear').textContent = CONFIG.date.slice(0,4);
  document.getElementById('photoCaption').textContent = (CONFIG.groomEn && CONFIG.brideEn) ? (CONFIG.groomEn + ' & ' + CONFIG.brideEn) : '';
  document.getElementById('printTitle').textContent = slashDate(CONFIG.date) + ' ' + namesLine + ' 婚禮當天流程';
  document.getElementById('printVenue').textContent = CONFIG.venue;
  if(CONFIG.photoUrl){
    var img = document.createElement('img');
    img.src = CONFIG.photoUrl;
    img.alt = CONFIG.groom + '與' + CONFIG.bride + '的婚紗照';
    var slot = document.getElementById('photoSlot');
    slot.innerHTML = '';
    slot.appendChild(img);
  }

  // ---------- tabs ----------
  var tabs = document.querySelectorAll('.tab-btn');
  tabs.forEach(function(btn){
    btn.addEventListener('click', function(){
      tabs.forEach(function(t){ t.classList.toggle('active', t === btn); });
      document.querySelectorAll('.panel').forEach(function(p){ p.classList.toggle('active', p.id === 'panel-' + btn.dataset.tab); });
    });
  });

  // ---------- countdown ----------
  (function(){
    var diffDays = Math.ceil((WEDDING_DATE - new Date()) / 864e5);
    var num = document.getElementById('countdownNum'), lbl = document.getElementById('countdownLabel');
    if(diffDays > 0){ num.textContent = diffDays; }
    else if(diffDays === 0){ num.textContent = '0'; lbl.textContent = '天，就是今天'; }
    else { num.textContent = '♡'; lbl.textContent = '婚禮圓滿完成'; }
  })();

  // ===== Google Apps Script 連線 =====
  var APPS_SCRIPT_URL = CONFIG.appsScriptUrl;
  var isConfigured = !!APPS_SCRIPT_URL && APPS_SCRIPT_URL.indexOf('PASTE_YOUR') !== 0;
  var syncStatusEl = document.getElementById('syncStatus');
  var syncBarEl = document.querySelector('.sync-bar');
  var state = { Checklist: [], Itinerary: [], Vendors: [], Payments: [], Props: [] };
  var loadedOnce = false;

  function setSyncStatus(text, isError){ syncStatusEl.textContent = text; syncBarEl.classList.toggle('error', !!isError); }
  function toBool(v){ return v === true || v === 'TRUE' || v === 'true' || v === 1 || v === '1'; }
  function toNum(v){ var n = parseFloat(v); return isNaN(n) ? 0 : n; }
  function toStr(v){ return (v === undefined || v === null) ? '' : String(v); }
  function newId(prefix){ return prefix + '-' + Date.now() + '-' + Math.random().toString(36).slice(2,6); }

  var lastSyncTime = null;
  function updateExportLabels(){
    document.getElementById('itinUpdatedLabel').textContent = lastSyncTime ? ('資料更新時間：' + lastSyncTime) : '';
    document.getElementById('printUpdatedTime').textContent = lastSyncTime || '';
  }

  async function loadAll(silent){
    if(!isConfigured){
      setSyncStatus('⚠️ 尚未設定 Google Apps Script 連線，請在程式碼最上方的設定區貼上 appsScriptUrl。', true);
      renderItin();
      return;
    }
    if(!silent) setSyncStatus('正在讀取最新資料…');
    try{
      var res = await fetch(APPS_SCRIPT_URL + '?_=' + Date.now());
      if(!res.ok) throw new Error('HTTP ' + res.status);
      var data = await res.json();
      state.Checklist = (data.Checklist || []).map(normalizeChecklistRow);
      state.Itinerary = (data.Itinerary || []).map(normalizeItinRow);
      state.Vendors = (data.Vendors || []).map(normalizeVendorRow);
      state.Payments = (data.Payments || []).map(normalizePaymentRow);
      state.Props = (data.Props || []).map(normalizePropRow);
      loadedOnce = true;
      renderChecklist(); updateProgress();
      renderItin(); renderPropsChecklist();
      renderVendors();
      if(paymentsUnlocked) renderPayments();
      lastSyncTime = new Date().toLocaleString('zh-TW');
      updateExportLabels();
      setSyncStatus('已同步（' + new Date().toLocaleTimeString('zh-TW') + '）');
    }catch(e){
      console.error('Sync load error', e);
      setSyncStatus('⚠️ 讀取失敗，請確認 Apps Script 是否已正確部署，或稍後點「重新整理」再試一次。', true);
    }
  }

  async function postAction(payload){
    if(!isConfigured) return null;
    try{
      var res = await fetch(APPS_SCRIPT_URL, {method:'POST', headers:{'Content-Type':'text/plain;charset=utf-8'}, body: JSON.stringify(payload)});
      var data = await res.json();
      if(!data.ok) throw new Error(data.error || 'unknown error');
      return data;
    }catch(e){
      console.error('Sync write error', e);
      setSyncStatus('⚠️ 這筆變更同步失敗，請檢查網路連線後點「重新整理」確認狀態。', true);
      return null;
    }
  }

  document.getElementById('refreshBtn').addEventListener('click', function(){ loadAll(false); });
  setInterval(function(){
    var a = document.activeElement;
    var typing = a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.isContentEditable);
    if(!typing) loadAll(true);
  }, 20000);

  function normalizeChecklistRow(r){
    return {id:toStr(r.id), phase:toStr(r.phase), category:toStr(r.category), text:toStr(r.text), done:toBool(r.done), desc:toStr(r.desc), ref_link:toStr(r.ref_link), file_link:toStr(r.file_link), order:toNum(r.order)};
  }
  function pick(r, keys){ for(var i=0;i<keys.length;i++){ if(r[keys[i]] !== undefined) return r[keys[i]]; } return ''; }
  function normalizeItinRow(r){
    return {
      id:toStr(r.id),
      time:toStr(pick(r,['開始時間','時間','time'])),
      end_time:toStr(pick(r,['結束時間','end_time'])),
      outline:toStr(pick(r,['大綱','outline'])),
      summary:toStr(pick(r,['概要內容','概要說明','summary'])),
      music:toStr(pick(r,['音樂','music'])),
      screen:toStr(pick(r,['投影幕','screen'])),
      props:toStr(pick(r,['道具','props'])),
      note:toStr(pick(r,['備註','note'])),
      order:toNum(r.order)
    };
  }
  function normalizeVendorRow(r){
    return {id:toStr(r.id), category:toStr(r.category), name:toStr(r.name), contact:toStr(r.contact), phone:toStr(r.phone), line:toStr(r.LINE !== undefined ? r.LINE : r.line), arrival:toStr(r.arrival), note:toStr(r.note),
      staff_count:toStr(r['工作人員人數']), meat_count:toStr(r['葷食']), veg_count:toStr(r['素食']), dietary_restriction:toStr(r['飲食禁忌']), order:toNum(r.order)};
  }

  // ================= 檢核表：截止日（依婚禮日期自動回推） =================
  function addMonths(d, m){ var x = new Date(d); x.setMonth(x.getMonth() + m); return x; }
  function addDays(d, n){ return new Date(d.getTime() + n*864e5); }
  var PHASE_DEFS = [
    {names:['婚禮前 3-4 個月（現在）','婚禮前 3-4 個月','婚禮前 3 個月'], due:addMonths(WEDDING_DATE,-3)},
    {names:['婚禮前 2-3 個月','婚禮前 2 個月'], due:addMonths(WEDDING_DATE,-2)},
    {names:['婚禮前 1 個月'], due:addMonths(WEDDING_DATE,-1)},
    {names:['婚禮前 2 週'], due:addDays(WEDDING_DATE,-14)},
    {names:['婚禮前 1 週'], due:addDays(WEDDING_DATE,-7)},
    {names:['婚禮當天'], due:WEDDING_DATE}
  ];
  function getPhaseDueDate(phase){
    phase = (phase || '').trim();
    for(var i=0;i<PHASE_DEFS.length;i++){
      if(PHASE_DEFS[i].names.indexOf(phase) !== -1) return ymd(PHASE_DEFS[i].due);
    }
    // 階段名稱若直接寫日期（例如「2027/02/20 前」），就用那個日期
    var m = phase.match(/(\d{4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})/);
    if(m) return m[1] + '-' + pad(+m[2]) + '-' + pad(+m[3]);
    return null;
  }
  function formatRelative(dueStr){
    var today = new Date(); today.setHours(0,0,0,0);
    var diff = Math.round((new Date(dueStr + 'T00:00:00') - today) / 864e5);
    if(diff > 0) return diff >= 45 ? ('還有約 ' + Math.round(diff/30) + ' 個月') : ('還有 ' + diff + ' 天');
    if(diff === 0) return '就是今天';
    return '已超過 ' + Math.abs(diff) + ' 天';
  }
  function taskStatus(item){
    if(item.done) return 'done';
    var due = getPhaseDueDate(item.phase);
    if(!due) return '';
    var today = ymd(new Date());
    if(today > due) return 'overdue';
    if(today >= ymd(addDays(new Date(due + 'T00:00:00'), -14))) return 'soon';
    return '';
  }

  function updateProgress(){
    var total = state.Checklist.length;
    var done = state.Checklist.filter(function(i){ return i.done; }).length;
    var pct = total ? Math.round(done/total*100) : 0;
    document.getElementById('progressPct').textContent = pct + '% (' + done + '/' + total + ')';
    document.getElementById('progressFill').style.width = pct + '%';
  }

  function groupByPhase(items){
    var order = [], groups = {};
    items.slice().sort(function(a,b){ return a.order - b.order; }).forEach(function(it){
      if(!groups[it.phase]){ groups[it.phase] = []; order.push(it.phase); }
      groups[it.phase].push(it);
    });
    order.forEach(function(p){
      groups[p].sort(function(a,b){
        var d = (a.done?1:0) - (b.done?1:0);
        return d !== 0 ? d : (a.category||'').localeCompare(b.category||'', 'zh-Hant');
      });
    });
    var list = order.map(function(p){ return {phase:p, items:groups[p]}; });
    list.sort(function(a,b){
      var ad = a.items.length && a.items.every(function(i){ return i.done; });
      var bd = b.items.length && b.items.every(function(i){ return i.done; });
      return ad === bd ? 0 : (ad ? 1 : -1);
    });
    return list;
  }

  var linkEditorOpen = {}, descEditorOpenMap = {};

  function renderChecklist(){
    var container = document.getElementById('checklistContainer');
    container.innerHTML = '';
    groupByPhase(state.Checklist).forEach(function(group){
      var block = document.createElement('div');
      block.className = 'phase-block';
      var head = document.createElement('div');
      head.className = 'phase-head';
      var doneCount = group.items.filter(function(i){ return i.done; }).length;
      var due = getPhaseDueDate(group.phase);
      var dueLabel = due ? '　<span class="phase-due">' + slashDate(due) + '　' + formatRelative(due) + '</span>' : '';
      head.innerHTML = '<span class="phase-title">' + esc(group.phase) + dueLabel + '</span><span class="phase-count">' + doneCount + ' / ' + group.items.length + '</span>';
      block.appendChild(head);

      group.items.forEach(function(item){
        var status = taskStatus(item);
        var row = document.createElement('div');
        row.className = 'task-row' + (item.done ? ' done' : '') + (status ? ' status-' + status : '');

        var cb = document.createElement('input');
        cb.type = 'checkbox'; cb.checked = item.done;
        cb.addEventListener('change', function(){
          item.done = cb.checked; renderChecklist(); updateProgress();
          postAction({action:'update', sheet:'Checklist', id:item.id, fields:{done: item.done ? 'TRUE' : 'FALSE'}});
        });
        var cat = document.createElement('input');
        cat.type = 'text'; cat.className = 'task-category'; cat.placeholder = '大類'; cat.value = item.category || '';
        cat.addEventListener('change', function(){
          item.category = cat.value;
          postAction({action:'update', sheet:'Checklist', id:item.id, fields:{category:item.category}});
        });
        var txt = document.createElement('input');
        txt.type = 'text'; txt.className = 'task-text'; txt.value = item.text;
        txt.addEventListener('change', function(){
          item.text = txt.value;
          postAction({action:'update', sheet:'Checklist', id:item.id, fields:{text:item.text}});
        });
        var del = document.createElement('button');
        del.className = 'task-del'; del.textContent = '刪除';
        del.addEventListener('click', function(){
          state.Checklist = state.Checklist.filter(function(i){ return i.id !== item.id; });
          renderChecklist(); updateProgress();
          postAction({action:'delete', sheet:'Checklist', id:item.id});
        });
        row.appendChild(cb); row.appendChild(cat); row.appendChild(txt); row.appendChild(del);

        var meta = document.createElement('div');
        meta.className = 'task-meta-row' + (status ? ' status-' + status : '');
        var descOpen = !!descEditorOpenMap[item.id];

        if(item.desc && !descOpen){
          var d = document.createElement('span');
          d.className = 'task-desc-inline'; d.textContent = item.desc; d.title = '點擊修改說明';
          d.addEventListener('click', function(){ descEditorOpenMap[item.id] = true; renderChecklist(); });
          meta.appendChild(d);
        }else if(descOpen){
          var di = document.createElement('input');
          di.type = 'text'; di.placeholder = '為什麼要做這件事？可以補充說明給新人看…'; di.value = item.desc || '';
          di.addEventListener('blur', function(){
            item.desc = di.value; delete descEditorOpenMap[item.id];
            postAction({action:'update', sheet:'Checklist', id:item.id, fields:{desc:item.desc}});
            renderChecklist();
          });
          meta.appendChild(di);
          setTimeout(function(){ di.focus(); }, 0);
        }

        if(linkEditorOpen[item.id]){
          var ri = document.createElement('input');
          ri.type = 'text'; ri.placeholder = '參考資料連結…'; ri.value = item.ref_link || '';
          ri.addEventListener('change', function(){
            item.ref_link = ri.value;
            postAction({action:'update', sheet:'Checklist', id:item.id, fields:{ref_link:item.ref_link}});
          });
          var fi = document.createElement('input');
          fi.type = 'text'; fi.placeholder = '上傳檔案連結…'; fi.value = item.file_link || '';
          fi.addEventListener('change', function(){
            item.file_link = fi.value;
            postAction({action:'update', sheet:'Checklist', id:item.id, fields:{file_link:item.file_link}});
          });
          var doneBtn = document.createElement('button');
          doneBtn.className = 'task-link-edit-toggle'; doneBtn.textContent = '完成';
          doneBtn.addEventListener('click', function(){ delete linkEditorOpen[item.id]; renderChecklist(); });
          meta.appendChild(ri); meta.appendChild(fi); meta.appendChild(doneBtn);
        }else{
          [['ref_link','🔗 參考資料'],['file_link','📁 上傳檔案']].forEach(function(pair){
            var url = (item[pair[0]] || '').trim();
            if(/^https?:\/\//i.test(url)){
              var a = document.createElement('a');
              a.href = url; a.target = '_blank'; a.rel = 'noopener'; a.className = 'task-link-open'; a.textContent = pair[1];
              meta.appendChild(a);
            }
          });
          var eb = document.createElement('button');
          eb.className = 'task-link-edit-toggle'; eb.textContent = '✎ 編輯連結';
          eb.addEventListener('click', function(){ linkEditorOpen[item.id] = true; renderChecklist(); });
          meta.appendChild(eb);
        }
        if(!item.desc && !descOpen){
          var ab = document.createElement('button');
          ab.className = 'task-link-edit-toggle'; ab.textContent = '✎ 新增說明';
          ab.addEventListener('click', function(){ descEditorOpenMap[item.id] = true; renderChecklist(); });
          meta.appendChild(ab);
        }
        block.appendChild(row); block.appendChild(meta);
      });

      var addRow = document.createElement('div');
      addRow.className = 'add-task-row';
      var ac = document.createElement('input');
      ac.type = 'text'; ac.placeholder = '大類（選填）'; ac.style.maxWidth = '110px';
      var ai = document.createElement('input');
      ai.type = 'text'; ai.placeholder = '新增這個階段的項目…';
      var abtn = document.createElement('button');
      abtn.className = 'btn-ink'; abtn.textContent = '新增';
      abtn.addEventListener('click', function(){
        var val = ai.value.trim();
        if(!val) return;
        var maxOrder = state.Checklist.reduce(function(m,i){ return Math.max(m,i.order); }, 0);
        var it = {id:newId('c'), phase:group.phase, category:ac.value.trim(), text:val, done:false, desc:'', ref_link:'', file_link:'', order:maxOrder+1};
        state.Checklist.push(it);
        renderChecklist(); updateProgress();
        postAction({action:'add', sheet:'Checklist', fields:{id:it.id, phase:it.phase, category:it.category, text:it.text, done:'FALSE', desc:'', ref_link:'', file_link:'', order:it.order}});
      });
      ai.addEventListener('keydown', function(e){ if(e.key === 'Enter') abtn.click(); });
      addRow.appendChild(ac); addRow.appendChild(ai); addRow.appendChild(abtn);
      block.appendChild(addRow);
      container.appendChild(block);
    });
  }

  // ================= 婚禮流程 =================
  var ITIN_SHEET_COL = {time:'開始時間', end_time:'結束時間', outline:'大綱', summary:'概要內容', music:'音樂', screen:'投影幕', props:'道具', note:'備註'};

  function makeItinCell(row, field, placeholder){
    var td = document.createElement('td');
    var cell = document.createElement('div');
    cell.className = 'cell'; cell.contentEditable = 'true';
    cell.textContent = row[field] || '';
    if(!row[field] && placeholder){ cell.classList.add('empty'); cell.dataset.placeholder = placeholder; }
    cell.addEventListener('focus', function(){ cell.classList.remove('empty'); });
    cell.addEventListener('blur', function(){
      var val = cell.textContent.trim();
      row[field] = val;
      if(!val && placeholder) cell.classList.add('empty');
      var f = {}; f[ITIN_SHEET_COL[field] || field] = val;
      postAction({action:'update', sheet:'Itinerary', id:row.id, fields:f});
      if(field === 'props') renderPropsChecklist();
    });
    cell.addEventListener('keydown', function(e){
      if(e.key === 'Enter' && field !== 'summary' && field !== 'note'){ e.preventDefault(); cell.blur(); }
    });
    td.appendChild(cell);
    return td;
  }

  function itinFields(row){
    return {id:row.id, '開始時間':row.time, '結束時間':row.end_time, '大綱':row.outline, '概要內容':row.summary, '音樂':row.music, '投影幕':row.screen, '道具':row.props, '備註':row.note, order:row.order};
  }

  var seeding = false;
  async function seedDefaultItinerary(){
    if(seeding) return;
    seeding = true;
    var base = state.Itinerary.reduce(function(m,i){ return Math.max(m,i.order); }, 0);
    var rows = DEFAULT_ITINERARY.map(function(d, idx){
      return {id:newId('i'), time:'', end_time:'', outline:d.outline, summary:d.summary, music:d.music, screen:d.screen, props:d.props, note:d.note, order:base+idx+1};
    });
    rows.forEach(function(r){ state.Itinerary.push(r); });
    renderItin(); renderPropsChecklist();
    for(var i=0;i<rows.length;i++){ await postAction({action:'add', sheet:'Itinerary', fields:itinFields(rows[i])}); }
    seeding = false;
  }

  document.getElementById('replaceItinBtn').addEventListener('click', async function(){
    if(isConfigured && !loadedOnce){ alert('資料還在讀取中，請稍候再試。'); return; }
    if(!confirm('這會刪除目前所有流程項目，改成預設的流程草案（接待 → 開場進場 → 戒指儀式 → 小遊戲 → 敬酒 → 甜點收尾 → 送客）。確定要取代嗎？')) return;
    var old = state.Itinerary.slice();
    state.Itinerary = [];
    renderItin();
    for(var i=0;i<old.length;i++){ await postAction({action:'delete', sheet:'Itinerary', id:old[i].id}); }
    await seedDefaultItinerary();
  });

  function renderItin(){
    var tbody = document.getElementById('itinContainer');
    tbody.innerHTML = '';
    var rows = state.Itinerary.slice().sort(function(a,b){ return a.order - b.order; });
    if(rows.length === 0){
      var tr0 = document.createElement('tr');
      var td0 = document.createElement('td');
      td0.colSpan = 9;
      td0.innerHTML = '<div class="seed-box">目前還沒有流程項目。<br>可以一鍵帶入「接待 → 開場進場 → 戒指儀式 → 小遊戲 → 敬酒 → 甜點收尾 → 送客」的草案，再逐項修改。<br></div>';
      var sb = document.createElement('button');
      sb.className = 'btn-ink'; sb.textContent = '帶入預設流程草案';
      sb.disabled = isConfigured && !loadedOnce;
      sb.addEventListener('click', seedDefaultItinerary);
      td0.firstChild.appendChild(sb);
      tr0.appendChild(td0); tbody.appendChild(tr0);
      return;
    }
    rows.forEach(function(row){
      var tr = document.createElement('tr');
      var t1 = makeItinCell(row,'time','開始'); t1.firstChild.classList.add('itin-time-cell'); tr.appendChild(t1);
      var t2 = makeItinCell(row,'end_time','結束'); t2.firstChild.classList.add('itin-time-cell'); tr.appendChild(t2);
      var t3 = makeItinCell(row,'outline','大綱…'); t3.firstChild.classList.add('itin-process-cell'); tr.appendChild(t3);
      tr.appendChild(makeItinCell(row,'summary','概要內容…'));
      tr.appendChild(makeItinCell(row,'music','音樂…'));
      tr.appendChild(makeItinCell(row,'screen','投影幕…'));
      tr.appendChild(makeItinCell(row,'props','道具…'));
      tr.appendChild(makeItinCell(row,'note','備註…'));
      var dtd = document.createElement('td'); dtd.className = 'itin-del-col';
      var del = document.createElement('button');
      del.className = 'itin-del'; del.textContent = '刪除';
      del.addEventListener('click', function(){
        state.Itinerary = state.Itinerary.filter(function(i){ return i.id !== row.id; });
        renderItin(); renderPropsChecklist();
        postAction({action:'delete', sheet:'Itinerary', id:row.id});
      });
      dtd.appendChild(del); tr.appendChild(dtd);
      tbody.appendChild(tr);
    });
  }

  document.getElementById('addItinBtn').addEventListener('click', function(){
    var maxOrder = state.Itinerary.reduce(function(m,i){ return Math.max(m,i.order); }, 0);
    var row = {id:newId('i'), time:'', end_time:'', outline:'', summary:'', music:'', screen:'', props:'', note:'', order:maxOrder+1};
    state.Itinerary.push(row);
    renderItin(); renderPropsChecklist();
    postAction({action:'add', sheet:'Itinerary', fields:itinFields(row)});
  });

  function exportItinExcel(){
    if(typeof XLSX === 'undefined'){ alert('匯出功能載入失敗，請檢查網路連線後重新整理頁面再試一次。'); return; }
    var rows = state.Itinerary.slice().sort(function(a,b){ return a.order - b.order; });
    var aoa = [
      [slashDate(CONFIG.date) + ' ' + namesLine + '・婚禮當天流程（' + CONFIG.venue + '）'],
      ['資料更新時間：' + (lastSyncTime || '')], [],
      ['開始時間','結束時間','大綱','概要內容','音樂','投影幕','道具','備註']
    ].concat(rows.map(function(r){ return [r.time, r.end_time, r.outline, r.summary, r.music, r.screen, r.props, r.note]; }));
    var ws = XLSX.utils.aoa_to_sheet(aoa);
    ws['!cols'] = [{wch:8},{wch:8},{wch:16},{wch:28},{wch:18},{wch:18},{wch:18},{wch:30}];
    var wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, '婚禮流程');
    XLSX.writeFile(wb, CONFIG.date.slice(5).replace('-','') + '婚禮流程_' + (lastSyncTime || '').replace(/[\/: ]/g,'') + '.xlsx');
  }
  document.getElementById('exportExcelBtn').addEventListener('click', exportItinExcel);
  document.getElementById('exportPdfBtn').addEventListener('click', function(){ window.print(); });

  // ---------- 道具核對清單 ----------
  function normalizePropRow(r){ return {id:toStr(r.id), name:toStr(r.name), done:toBool(r.done), order:toNum(r.order)}; }
  function extractPropsList(){
    var names = [];
    state.Itinerary.forEach(function(row){
      (row.props || '').split(/[、,，\/／\n]+/).forEach(function(p){
        var n = p.trim();
        if(n && names.indexOf(n) === -1) names.push(n);
      });
    });
    return names;
  }
  function findPropByName(name){ return state.Props.find(function(p){ return p.name === name; }); }
  var propsAddRequested = {};

  function renderPropsChecklist(){
    var names = extractPropsList();
    var listEl = document.getElementById('propsList');
    var block = document.getElementById('propsChecklist');
    if(names.length === 0){ block.style.display = 'none'; return; }
    block.style.display = 'block';
    names.forEach(function(name){
      if(!findPropByName(name) && !propsAddRequested[name]){
        propsAddRequested[name] = true;
        var maxOrder = state.Props.reduce(function(m,p){ return Math.max(m,p.order); }, 0);
        var np = {id:newId('pr'), name:name, done:false, order:maxOrder+1};
        state.Props.push(np);
        postAction({action:'add', sheet:'Props', fields:{id:np.id, name:np.name, done:'FALSE', order:np.order}});
      }
    });
    listEl.innerHTML = '';
    names.forEach(function(name){
      var prop = findPropByName(name);
      if(!prop) return;
      var lab = document.createElement('label');
      lab.className = 'props-item' + (prop.done ? ' done' : '');
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.checked = prop.done;
      cb.addEventListener('change', function(){
        prop.done = cb.checked; lab.classList.toggle('done', cb.checked);
        postAction({action:'update', sheet:'Props', id:prop.id, fields:{done: prop.done ? 'TRUE' : 'FALSE'}});
      });
      var sp = document.createElement('span'); sp.textContent = name;
      lab.appendChild(cb); lab.appendChild(sp); listEl.appendChild(lab);
    });
  }

  // ================= 廠商聯繫清單 =================
  var VENDOR_SHEET_COL = {line:'LINE', staff_count:'工作人員人數', meat_count:'葷食', veg_count:'素食', dietary_restriction:'飲食禁忌'};
  var VENDOR_MUTED_FIELDS = {staff_count:1, meat_count:1, veg_count:1, dietary_restriction:1};
  var MUTED_A = /^\s*(不用|不需要?|不必)(準備|填寫|填|了|提供|供餐|用餐|餐點|安排|預留|訂|餐)?\s*[。.!！]?\s*$/;
  var MUTED_B = /^\s*(無|免|沒有|n\/?a|[-－—–]+)\s*[。.!！]?\s*$/i;
  function isMutedValue(v){ var t = String(v == null ? '' : v); return MUTED_A.test(t) || MUTED_B.test(t); }

  function makeVendorCell(row, field, placeholder){
    var td = document.createElement('td');
    var cell = document.createElement('div');
    cell.className = 'cell'; cell.contentEditable = 'true';
    cell.textContent = row[field] || '';
    if(!row[field] && placeholder){ cell.classList.add('empty'); cell.dataset.placeholder = placeholder; }
    if(VENDOR_MUTED_FIELDS[field] && isMutedValue(row[field])) cell.classList.add('muted-value');
    cell.addEventListener('focus', function(){ cell.classList.remove('empty'); });
    cell.addEventListener('blur', function(){
      var val = cell.textContent.trim();
      row[field] = val;
      if(!val && placeholder) cell.classList.add('empty');
      cell.classList.toggle('muted-value', !!(VENDOR_MUTED_FIELDS[field] && isMutedValue(val)));
      var f = {}; f[VENDOR_SHEET_COL[field] || field] = val;
      postAction({action:'update', sheet:'Vendors', id:row.id, fields:f});
    });
    cell.addEventListener('keydown', function(e){ if(e.key === 'Enter'){ e.preventDefault(); cell.blur(); } });
    td.appendChild(cell);
    return td;
  }

  function renderVendors(){
    var tbody = document.getElementById('vendorTbody');
    tbody.innerHTML = '';
    state.Vendors.slice().sort(function(a,b){ return a.order - b.order; }).forEach(function(row){
      var tr = document.createElement('tr');
      [['category','類別'],['name','廠商名稱'],['contact','聯絡人'],['phone','電話'],['line','LINE ID'],['arrival','到場時間'],['staff_count','人數'],['meat_count','葷食'],['veg_count','素食'],['dietary_restriction','飲食禁忌'],['note','備註']]
        .forEach(function(c){ tr.appendChild(makeVendorCell(row, c[0], c[1])); });
      var dtd = document.createElement('td');
      var del = document.createElement('button');
      del.className = 'vendor-del'; del.textContent = '刪除';
      del.addEventListener('click', function(){
        state.Vendors = state.Vendors.filter(function(i){ return i.id !== row.id; });
        renderVendors();
        postAction({action:'delete', sheet:'Vendors', id:row.id});
      });
      dtd.appendChild(del); tr.appendChild(dtd);
      tbody.appendChild(tr);
    });
  }

  document.getElementById('addVendorBtn').addEventListener('click', function(){
    var maxOrder = state.Vendors.reduce(function(m,i){ return Math.max(m,i.order); }, 0);
    var row = {id:newId('v'), category:'', name:'', contact:'', phone:'', line:'', arrival:'', note:'', staff_count:'', meat_count:'', veg_count:'', dietary_restriction:'', order:maxOrder+1};
    state.Vendors.push(row);
    renderVendors();
    postAction({action:'add', sheet:'Vendors', fields:{id:row.id, category:'', name:'', contact:'', phone:'', LINE:'', arrival:'', note:'', '工作人員人數':'', '葷食':'', '素食':'', '飲食禁忌':'', order:row.order}});
  });

  // ================= 廠商尾款 =================
  var paymentsUnlocked = false;
  function normalizePaymentRow(r){
    return {id:toStr(r.id), name:toStr(r.name), role:toStr(r.role), amount:toStr(r.amount), pay_method:toStr(r.pay_method), pay_label:toStr(r.pay_label),
      when:toStr(r.when), when_label:toStr(r.when_label), contact:toStr(r.contact !== undefined ? r.contact : r.Contact), note:toStr(r.note), flag:toBool(r.flag), confirmed:toBool(r.confirmed), order:toNum(r.order)};
  }
  function parseAmount(v){ var n = parseFloat((v||'').toString().replace(/[^0-9.]/g,'')); return isNaN(n) ? null : n; }

  function renderPayments(){
    var rows = state.Payments.slice().sort(function(a,b){ return a.order - b.order; });
    var list = document.getElementById('paymentsCardList');
    list.innerHTML = '';
    var total = rows.reduce(function(s,p){ var n = parseAmount(p.amount); return s + (n || 0); }, 0);
    document.getElementById('paymentsTotalAmount').textContent = 'NT$ ' + total.toLocaleString('en-US');
    document.getElementById('paymentsTotalCount').textContent = rows.length;
    var cc = rows.filter(function(p){ return p.confirmed; }).length;
    document.getElementById('paymentsCheckedCount').textContent = cc;
    document.getElementById('paymentsProgressFill').style.width = (rows.length ? Math.round(cc/rows.length*100) : 0) + '%';

    rows.forEach(function(p){
      var card = document.createElement('div');
      card.className = 'payment-card' + (p.flag ? ' flagged' : '') + (p.confirmed ? ' confirmed' : '');
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.checked = p.confirmed;
      cb.addEventListener('change', function(){
        p.confirmed = cb.checked; renderPayments();
        postAction({action:'update', sheet:'Payments', id:p.id, fields:{confirmed: p.confirmed ? 'TRUE' : 'FALSE'}});
      });
      var mid = document.createElement('div');
      mid.innerHTML = '<div class="payment-name">' + esc(p.name) + '</div>' +
        (p.role ? '<div class="payment-role">' + esc(p.role) + '</div>' : '') +
        (p.contact ? '<div class="payment-contact">' + esc(p.contact).replace(/\|/g,'　') + '</div>' : '') +
        (p.note ? '<div class="payment-note">' + esc(p.note) + '</div>' : '');
      var right = document.createElement('div');
      right.className = 'payment-amount-block';
      var amt = parseAmount(p.amount);
      var payCls = p.pay_method === 'card' ? 'card' : 'cash';
      var whenCls = p.when === 'pending' ? 'pending' : (p.when === 'after' ? 'after' : 'cash');
      right.innerHTML = '<div class="payment-amount">' + (amt !== null && p.amount ? 'NT$ ' + amt.toLocaleString('en-US') : '－') + '</div><div>' +
        (p.pay_label ? '<span class="payment-badge ' + payCls + '">' + esc(p.pay_label) + '</span>' : '') +
        (p.when_label ? '<span class="payment-badge ' + whenCls + '">' + esc(p.when_label) + '</span>' : '') + '</div>';
      card.appendChild(cb); card.appendChild(mid); card.appendChild(right);
      list.appendChild(card);
    });
  }

  var passInput = document.getElementById('paymentsPasscode');
  function tryUnlockPayments(){
    if(passInput.value === CONFIG.paymentsPasscode){
      paymentsUnlocked = true;
      renderPayments();
      document.getElementById('paymentsGate').style.display = 'none';
      document.getElementById('paymentsContent').classList.add('open');
      document.getElementById('paymentsErr').style.display = 'none';
    }else{
      document.getElementById('paymentsErr').style.display = 'block';
    }
  }
  document.getElementById('paymentsUnlock').addEventListener('click', tryUnlockPayments);
  passInput.addEventListener('keydown', function(e){ if(e.key === 'Enter') tryUnlockPayments(); });

  loadAll(false);
})();
</script>
</body>
